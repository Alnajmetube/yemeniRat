name: Build ARMv7 Binary (Nuitka)

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-armv7:
    runs-on: ubuntu-latest

    steps:
      - name: سحب الكود
        uses: actions/checkout@v4

      - name: إعداد QEMU لمحاكاة ARMv7
        uses: docker/setup-qemu-action@v3

      - name: بناء الملف الثنائي داخل حاوية Linux ARMv7
        run: |
          docker run --rm \
            --platform linux/arm/v7 \
            -v ${{ github.workspace }}:/workspace \
            -w /workspace \
            python:3.10-slim \
            bash -c "
              set -e
              apt-get update && apt-get install -y --no-install-recommends \
                gcc g++ make patchelf zstd ccache python3-dev binutils
              pip install --upgrade pip
              pip install -r client_requirements.txt
              pip install nuitka

              python -m nuitka \
                --standalone \
                --onefile \
                --lto=yes \
                --remove-output \
                --output-dir=build \
                --output-filename=worker-armv7l \
                client.py

              strip build/worker-armv7l
            "

      - name: رفع الملف الناتج
        uses: actions/upload-artifact@v4
        with:
          name: worker-armv7l
          path: build/worker-armv7l
          if-no-files-found: error