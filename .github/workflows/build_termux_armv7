name: Build Termux ARMv7 Standalone Binary

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-termux-armv7:
    runs-on: ubuntu-latest

    steps:
      - name: سحب الكود
        uses: actions/checkout@v4

      - name: إعداد QEMU لمحاكاة ARMv7
        uses: docker/setup-qemu-action@v3

      - name: بناء الملف الثنائي داخل حاوية Termux ARMv7
        run: |
          docker run --rm \
            --platform linux/arm/v7 \
            -v ${{ github.workspace }}:/workspace \
            -w /workspace \
            termux/termux-docker:arm bash -c "
              set -e
              pkg update -y && pkg upgrade -y
              pkg install python clang build-essential patchelf zstd ccache -y
              pip install --upgrade pip
              pip install -r client_requirements.txt
              pip install nuitka

              nuitka --standalone \
                     --onefile \
                     --lto=yes \
                     --remove-output \
                     --output-dir=build \
                     --output-filename=worker-armv7l \
                     client.py

              strip build/worker-armv7l
            "

      - name: رفع الملف الناتج
        uses: actions/upload-artifact@v4
        with:
          name: worker-armv7l-termux
          path: build/worker-armv7l
          if-no-files-found: error