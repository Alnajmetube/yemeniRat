#!/usr/bin/env bash
# -*- coding: utf-8 -*-
# Worker Client for centralized task management (Bash version)
# Runs in foreground

set -euo pipefail

# ============================ Constants ====================================
HOME_DIR="${HOME:-$HOME}"
CONFIG_PATH="${HOME_DIR}/.worker_client.conf"
LOG_PATH="${HOME_DIR}/.worker_client.log"
QUEUE_DIR="${HOME_DIR}/.worker_client_queue"
LOCK_FILE="/tmp/worker_client.lock"
PID_FILE="/tmp/worker_client.pid"

DEFAULT_POLL_INTERVAL=2
MAX_BACKOFF=60
HEALTH_CHECK_INTERVAL=60
CANCEL_CHECK_INTERVAL=2
MAX_REPORT_LENGTH=10000

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ============================ Logging ======================================
log_info() {
    echo -e "${GREEN}[INFO]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $*"
    echo "[INFO] $(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOG_PATH"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $*" >&2
    echo "[WARN] $(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOG_PATH"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $*" >&2
    echo "[ERROR] $(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOG_PATH"
}

log_debug() {
    echo -e "${BLUE}[DEBUG]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $*"
    echo "[DEBUG] $(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOG_PATH"
}

# ============================ Configuration ===============================
load_config() {
    if [[ ! -f "$CONFIG_PATH" ]]; then
        log_error "Config file not found: $CONFIG_PATH"
        exit 1
    fi
    
    # Source the config file
    # shellcheck source=/dev/null
    source "$CONFIG_PATH"
    
    if [[ -z "${SERVER_URL:-}" ]] || [[ -z "${TOKEN:-}" ]]; then
        log_error "Missing required config keys: SERVER_URL and TOKEN"
        exit 1
    fi
    
    export SERVER_URL TOKEN
}

write_config() {
    local url="$1"
    local token="$2"
    cat > "$CONFIG_PATH" <<EOF
SERVER_URL="$url"
TOKEN="$token"
EOF
    chmod 600 "$CONFIG_PATH"
}

# ============================ Lock and PID ================================
acquire_lock() {
    # Use flock for locking
    exec 200>"$LOCK_FILE"
    if ! flock -n 200; then
        return 1
    fi
    echo $$ > "$LOCK_FILE"
    return 0
}

release_lock() {
    flock -u 200 2>/dev/null || true
}

write_pid() {
    echo $$ > "$PID_FILE"
}

remove_pid() {
    rm -f "$PID_FILE"
}

# ============================ HTTP Client =================================
# Use curl for HTTP requests

http_get() {
    local url="$1"
    local timeout="${2:-10}"
    curl -s -f -m "$timeout" "$url" 2>/dev/null || echo ""
}

http_post() {
    local url="$1"
    local data="$2"
    local timeout="${3:-10}"
    curl -s -f -m "$timeout" -X POST -H "Content-Type: application/json" -d "$data" "$url" 2>/dev/null || echo ""
}

http_post_file() {
    local url="$1"
    local file_path="$2"
    local task_id="$3"
    local token="$4"
    local timeout="${5:-30}"
    curl -s -f -m "$timeout" -X POST \
        -F "token=$token" \
        -F "task_id=$task_id" \
        -F "file=@$file_path" \
        "$url" 2>/dev/null || echo ""
}

# ============================ API Calls ===================================
health_check() {
    local url="${SERVER_URL}/worker/health?token=${TOKEN}"
    local response
    response=$(http_get "$url" 10)
    if [[ -n "$response" ]]; then
        local status
        status=$(echo "$response" | jq -r '.status // ""')
        [[ "$status" == "active" ]] || [[ "$status" == "ok" ]]
        return $?
    fi
    return 1
}

get_current_task() {
    local url="${SERVER_URL}/worker/current-task?token=${TOKEN}"
    local response
    response=$(http_get "$url" 10)
    if [[ -n "$response" ]]; then
        # Check if task exists and status is pending
        local task_status
        task_status=$(echo "$response" | jq -r '.task.status // ""')
        if [[ "$task_status" == "pending" ]]; then
            echo "$response" | jq -c '.task'
            return 0
        fi
    fi
    return 1
}

start_task() {
    local task_id="$1"
    local data
    data=$(jq -n --arg token "$TOKEN" --arg task_id "$task_id" \
        '{token: $token, task_id: ($task_id | tonumber)}')
    local url="${SERVER_URL}/worker/start-task"
    local response
    response=$(http_post "$url" "$data" 10)
    if [[ -n "$response" ]]; then
        local status
        status=$(echo "$response" | jq -r '.status // ""')
        [[ "$status" == "running" ]]
        return $?
    fi
    return 1
}

is_cancelled() {
    local task_id="$1"
    local url="${SERVER_URL}/worker/is-cancelled?token=${TOKEN}&task_id=${task_id}"
    local response
    response=$(http_get "$url" 10)
    if [[ -n "$response" ]]; then
        local cancelled
        cancelled=$(echo "$response" | jq -r '.cancelled // false')
        [[ "$cancelled" == "true" ]]
        return $?
    fi
    return 1
}

send_report() {
    local task_id="$1"
    local content="$2"
    local data
    # Truncate content if too long
    if [[ ${#content} -gt $MAX_REPORT_LENGTH ]]; then
        content="${content:0:$MAX_REPORT_LENGTH}\n... (truncated)"
    fi
    data=$(jq -n --arg token "$TOKEN" --arg task_id "$task_id" --arg content "$content" \
        '{token: $token, task_id: ($task_id | tonumber), content: $content}')
    local url="${SERVER_URL}/worker/report"
    local response
    response=$(http_post "$url" "$data" 10)
    [[ -n "$response" ]] && echo "$response" | jq -e '. == true' >/dev/null 2>&1
    return $?
}

upload_file() {
    local task_id="$1"
    local file_path="$2"
    local url="${SERVER_URL}/worker/upload"
    local response
    response=$(http_post_file "$url" "$file_path" "$task_id" "$TOKEN" 30)
    [[ -n "$response" ]] && echo "$response" | jq -e '. == true' >/dev/null 2>&1
    return $?
}

# ============================ Queue Management ============================
queue_report() {
    local task_id="$1"
    local content="$2"
    mkdir -p "$QUEUE_DIR"
    local queue_file="${QUEUE_DIR}/report_${task_id}.json"
    jq -n --arg task_id "$task_id" --arg content "$content" \
        '{task_id: ($task_id | tonumber), content: $content}' > "$queue_file"
}

queue_upload() {
    local task_id="$1"
    local file_path="$2"
    mkdir -p "$QUEUE_DIR"
    local queue_file="${QUEUE_DIR}/upload_${task_id}.file"
    cp "$file_path" "$queue_file"
}

process_queue() {
    if [[ ! -d "$QUEUE_DIR" ]]; then
        return
    fi
    
    # Process reports
    for queue_file in "$QUEUE_DIR"/report_*.json; do
        [[ -f "$queue_file" ]] || continue
        local task_id
        local content
        task_id=$(jq -r '.task_id' "$queue_file")
        content=$(jq -r '.content' "$queue_file")
        if send_report "$task_id" "$content"; then
            rm -f "$queue_file"
            log_info "Queued report for task $task_id sent."
        else
            log_warn "Queued report for task $task_id still failing."
        fi
    done
    
    # Process uploads
    for queue_file in "$QUEUE_DIR"/upload_*.file; do
        [[ -f "$queue_file" ]] || continue
        local task_id
        task_id=$(basename "$queue_file" | sed 's/upload_\([0-9]*\)\.file/\1/')
        if upload_file "$task_id" "$queue_file"; then
            rm -f "$queue_file"
            log_info "Queued upload for task $task_id sent."
        else
            log_warn "Queued upload for task $task_id still failing."
        fi
    done
}

# ============================ Upload Handler ==============================
handle_upload_command() {
    local task_id="$1"
    local command="$2"
    
    # Extract file path
    local file_path_str
    file_path_str=$(echo "$command" | cut -d' ' -f2- | xargs)
    
    if [[ -z "$file_path_str" ]]; then
        local error_msg="Upload command missing file path. Usage: upload <file_path>"
        log_error "Task $task_id: $error_msg"
        send_report "$task_id" "$error_msg"
        return
    fi
    
    local file_path="$file_path_str"
    
    if [[ ! -f "$file_path" ]]; then
        local error_msg="File not found: $file_path_str"
        log_error "Task $task_id: $error_msg"
        send_report "$task_id" "$error_msg"
        return
    fi
    
    log_info "Task $task_id: Uploading file $(basename "$file_path")"
    
    if ! start_task "$task_id"; then
        log_error "Task $task_id: Failed to start task"
        return
    fi
    
    local file_size
    file_size=$(stat -c%s "$file_path" 2>/dev/null || stat -f%z "$file_path" 2>/dev/null || echo "0")
    
    if upload_file "$task_id" "$file_path"; then
        local report_content="File uploaded successfully: $(basename "$file_path") (Size: $file_size bytes)"
        log_info "Task $task_id: $report_content"
    else
        local report_content="Failed to upload file: $(basename "$file_path")"
        log_warn "Task $task_id: $report_content"
        queue_upload "$task_id" "$file_path"
    fi
    
    if ! send_report "$task_id" "$report_content"; then
        log_warn "Task $task_id: Report failed, queuing."
        queue_report "$task_id" "$report_content"
    fi
}

# ============================ Task Execution ==============================
execute_task() {
    local task="$1"
    local task_id content command
    task_id=$(echo "$task" | jq -r '.id')
    content=$(echo "$task" | jq -r '.content')
    command="$content"
    
    log_info "Executing task $task_id: $command"
    
    # Special command: upload
    if [[ "$(echo "$command" | tr '[:upper:]' '[:lower:]' | xargs)" == upload* ]]; then
        handle_upload_command "$task_id" "$command"
        return
    fi
    
    # Normal shell command
    if ! start_task "$task_id"; then
        log_error "Failed to start task $task_id, aborting."
        return
    fi
    
    # Create temp file for output
    local temp_output
    temp_output=$(mktemp)
    local temp_error
    temp_error=$(mktemp)
    
    # Run command with timeout and output capture
    local exit_code=0
    {
        # Run the command
        eval "$command" > "$temp_output" 2> "$temp_error" &
        local pid=$!
        
        # Check for cancellation periodically
        while kill -0 $pid 2>/dev/null; do
            if is_cancelled "$task_id"; then
                log_info "Task $task_id cancelled, terminating process."
                kill -TERM $pid 2>/dev/null || true
                sleep 2
                kill -KILL $pid 2>/dev/null || true
                wait $pid 2>/dev/null || true
                local report_content="Task cancelled by server."
                send_report "$task_id" "$report_content"
                rm -f "$temp_output" "$temp_error"
                return
            fi
            sleep "$CANCEL_CHECK_INTERVAL"
        done
        
        wait $pid 2>/dev/null || true
        exit_code=$?
    }
    
    # Read outputs
    local stdout_content=""
    local stderr_content=""
    if [[ -f "$temp_output" ]]; then
        stdout_content=$(cat "$temp_output" 2>/dev/null || echo "")
    fi
    if [[ -f "$temp_error" ]]; then
        stderr_content=$(cat "$temp_error" 2>/dev/null || echo "")
    fi
    
    rm -f "$temp_output" "$temp_error"
    
    # Build report
    local report_content=""
    if [[ -n "$stdout_content" ]] && [[ -n "$stderr_content" ]]; then
        report_content="${stdout_content}\n${stderr_content}"
    elif [[ -n "$stdout_content" ]]; then
        report_content="$stdout_content"
    elif [[ -n "$stderr_content" ]]; then
        report_content="$stderr_content"
    else
        report_content="(empty output)"
    fi
    
    log_info "Task $task_id completed with exit code $exit_code"
    
    # Send report
    if ! send_report "$task_id" "$report_content"; then
        log_warn "Task $task_id report failed, queuing."
        queue_report "$task_id" "$report_content"
    fi
}

# ============================ Main Loop ===================================
run_forever() {
    local backoff=$DEFAULT_POLL_INTERVAL
    local last_health_check=0
    
    log_info "Starting worker in foreground mode..."
    log_info "Server: $SERVER_URL"
    
    while true; do
        # Process queue first
        process_queue
        
        # Health check periodically
        local now
        now=$(date +%s)
        if (( now - last_health_check >= HEALTH_CHECK_INTERVAL )); then
            if health_check; then
                log_debug "Health check OK"
            else
                log_warn "Health check failed (server may be down)"
            fi
            last_health_check=$now
        fi
        
        # Get current task
        local task
        task=$(get_current_task 2>/dev/null || echo "")
        
        if [[ -n "$task" ]]; then
            backoff=$DEFAULT_POLL_INTERVAL
            execute_task "$task"
        else
            log_debug "No pending task, sleeping for ${backoff}s..."
            sleep "$backoff"
        fi
    done
}

# ============================ Install / Uninstall / Stop ==================
install_worker() {
    local url="$1"
    local token="$2"
    
    log_info "Installing with SERVER_URL=$url"
    
    write_config "$url" "$token"
    mkdir -p "$QUEUE_DIR"
    
    log_info "Installation complete."
    log_info "You can run the worker with: $0"
}

uninstall_worker() {
    log_info "Uninstalling worker client..."
    
    # Remove files
    rm -f "$CONFIG_PATH"
    rm -rf "$QUEUE_DIR"
    rm -f "$LOCK_FILE" "$PID_FILE"
    
    log_info "Uninstall complete."
}

# ============================ Signal Handlers =============================
cleanup() {
    log_info "Received signal, shutting down..."
    remove_pid
    release_lock
    exit 0
}

trap cleanup SIGTERM SIGINT

# ============================ Main Entry ==================================
main() {
    # Parse arguments
    local action="run"
    local install_url=""
    local install_token=""
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --install)
                action="install"
                shift
                install_url="$1"
                shift
                install_token="$1"
                shift
                ;;
            --uninstall)
                action="uninstall"
                shift
                ;;
            --help|-h)
                echo "Usage: $0 [OPTIONS]"
                echo "Options:"
                echo "  --install <URL> <TOKEN>  Install worker client"
                echo "  --uninstall              Uninstall worker client"
                echo "  --help, -h              Show this help message"
                echo ""
                echo "Without options, runs the worker in foreground."
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information."
                exit 1
                ;;
        esac
    done
    
    case "$action" in
        install)
            if [[ -z "$install_url" ]] || [[ -z "$install_token" ]]; then
                echo "Error: --install requires URL and TOKEN"
                echo "Usage: $0 --install <URL> <TOKEN>"
                exit 1
            fi
            install_worker "$install_url" "$install_token"
            exit 0
            ;;
        uninstall)
            uninstall_worker
            exit 0
            ;;
        run)
            # Normal execution: load config, acquire lock, run loop
            load_config
            
            # Acquire lock – prevent multiple instances
            if ! acquire_lock; then
                log_error "Another instance is already running. Exiting."
                exit 1
            fi
            
            write_pid
            log_info "Worker started (PID $$)"
            log_info "Lock acquired, config loaded: SERVER_URL=$SERVER_URL"
            
            run_forever
            ;;
    esac
}

# Check if jq is installed
if ! command -v jq &> /dev/null; then
    echo "Error: jq is required but not installed."
    echo "Install with: apt install jq (Debian/Ubuntu) or pkg install jq (Termux)"
    exit 1
fi

# Check if curl is installed
if ! command -v curl &> /dev/null; then
    echo "Error: curl is required but not installed."
    echo "Install with: apt install curl (Debian/Ubuntu) or pkg install curl (Termux)"
    exit 1
fi

main "$@"