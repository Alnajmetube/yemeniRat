#!/usr/bin/env bash
# Worker Client - Stable, silent, persistent daemon with autostart via .bashrc

# Uncomment next line for debugging (logs will include every command)
# set -x

set -euo pipefail

# ----------------------------- Configuration -----------------------------
CONFIG_FILE="${HOME}/.worker_client.conf"
LOCK_FILE="/tmp/worker_client.lock"
PID_FILE="/tmp/worker_client.pid"
QUEUE_DIR="${HOME}/.worker_client_queue"
LOG_FILE="${HOME}/.worker_client.log"

TASK_POLL_INTERVAL=2
CANCEL_CHECK_INTERVAL=2
HEALTH_INTERVAL=60
BACKOFF_MIN=2
BACKOFF_MAX=60
CURRENT_BACKOFF=$BACKOFF_MIN
CONNECT_TIMEOUT=10
MAX_TIME=30

# ----------------------------- Helper Functions ---------------------------

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

check_deps() {
    for cmd in curl jq; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "ERROR: Required command '$cmd' not found." >&2
            exit 1
        fi
    done
}

acquire_lock() {
    exec 200>"$LOCK_FILE"
    if ! flock -n 200; then
        log "ERROR: Another instance is running (lock held). Exiting."
        exit 0
    fi
    echo $$ > "$PID_FILE"
    log "Lock acquired (PID $$)"
    trap 'release_lock' EXIT
}

release_lock() {
    log "Releasing lock"
    rm -f "$PID_FILE" 2>/dev/null || true
    flock -u 200 2>/dev/null || true
}

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
        log "Config loaded: SERVER_URL=$SERVER_URL, TOKEN=${TOKEN:0:4}..."
    else
        log "ERROR: Config file not found. Run with --install first."
        exit 1
    fi
    if [[ -z "${SERVER_URL:-}" || -z "${TOKEN:-}" ]]; then
        log "ERROR: SERVER_URL or TOKEN not set in config."
        exit 1
    fi
}

# ----------------------------- HTTP Helpers (with Accept header) -----------

http_get() {
    local url="$1"
    shift
    local response http_code curl_exit
    response=$(curl -s -w "%{http_code}" -H "Accept: application/json" \
        --connect-timeout "$CONNECT_TIMEOUT" --max-time "$MAX_TIME" -X GET "$url" "$@" 2>/dev/null)
    curl_exit=$?
    if [[ $curl_exit -ne 0 ]]; then
        log "curl GET failed with exit $curl_exit"
        return 2  # network error
    fi
    http_code="${response: -3}"
    response="${response%???}"
    if [[ "$http_code" -ge 400 ]]; then
        log "HTTP GET error: $http_code - $response"
        return 1  # HTTP error
    fi
    echo "$response"
    return 0
}

http_post() {
    local url="$1"
    local data="$2"
    local content_type="${3:-application/json}"
    local response http_code curl_exit
    response=$(curl -s -w "%{http_code}" -H "Accept: application/json" -H "Content-Type: $content_type" \
        --connect-timeout "$CONNECT_TIMEOUT" --max-time "$MAX_TIME" -X POST "$url" -d "$data" 2>/dev/null)
    curl_exit=$?
    if [[ $curl_exit -ne 0 ]]; then
        log "curl POST failed with exit $curl_exit"
        return 2
    fi
    http_code="${response: -3}"
    response="${response%???}"
    if [[ "$http_code" -ge 400 ]]; then
        log "HTTP POST error: $http_code - $response"
        return 1
    fi
    echo "$response"
    return 0
}

http_upload() {
    local url="$1"
    local file_path="$2"
    local token="$3"
    local task_id="$4"
    local response http_code curl_exit
    response=$(curl -s -w "%{http_code}" -H "Accept: application/json" \
        --connect-timeout "$CONNECT_TIMEOUT" --max-time "$MAX_TIME" -X POST "$url" \
        -F "token=$token" -F "task_id=$task_id" -F "file=@$file_path" 2>/dev/null)
    curl_exit=$?
    if [[ $curl_exit -ne 0 ]]; then
        log "curl UPLOAD failed with exit $curl_exit"
        return 2
    fi
    http_code="${response: -3}"
    response="${response%???}"
    if [[ "$http_code" -ge 400 ]]; then
        log "HTTP UPLOAD error: $http_code - $response"
        return 1
    fi
    echo "$response"
    return 0
}

# ----------------------------- Queue Helpers -----------------------------

queue_report() {
    local task_id="$1"
    local content="$2"
    mkdir -p "$QUEUE_DIR"
    echo "$content" > "$QUEUE_DIR/report_${task_id}.txt"
    log "Queued report for task $task_id"
}

queue_upload() {
    local task_id="$1"
    local file_path="$2"
    mkdir -p "$QUEUE_DIR"
    cp "$file_path" "$QUEUE_DIR/upload_${task_id}.file"
    log "Queued upload for task $task_id"
}

process_queue() {
    local task_id content f
    for f in "$QUEUE_DIR"/report_*.txt; do
        [[ -f "$f" ]] || continue
        task_id=$(basename "$f" | sed 's/^report_//; s/\.txt$//')
        content=$(cat "$f")
        if send_report "$task_id" "$content"; then
            rm -f "$f"
            log "Processed queued report for task $task_id"
        else
            log "Failed to send queued report for task $task_id, will retry"
            return 1
        fi
    done
    for f in "$QUEUE_DIR"/upload_*.file; do
        [[ -f "$f" ]] || continue
        task_id=$(basename "$f" | sed 's/^upload_//; s/\.file$//')
        if upload_file "$task_id" "$f"; then
            rm -f "$f"
            log "Processed queued upload for task $task_id"
        else
            log "Failed to upload queued file for task $task_id, will retry"
            return 1
        fi
    done
    return 0
}

# ----------------------------- API Functions -----------------------------

health_check() {
    local url="${SERVER_URL}/worker/health?token=${TOKEN}"
    if http_get "$url" >/dev/null 2>&1; then
        log "Health check OK"
        return 0
    else
        log "Health check FAILED"
        return 1
    fi
}

get_current_task() {
    local url="${SERVER_URL}/worker/current-task?token=${TOKEN}"
    local response
    if ! response=$(http_get "$url"); then
        log "get_current_task: network or HTTP error"
        return 2
    fi
    # Validate JSON
    if ! echo "$response" | jq . >/dev/null 2>&1; then
        log "get_current_task: invalid JSON response"
        echo "null"
        return 0
    fi
    local task_id
    task_id=$(echo "$response" | jq -r '.task.id // empty')
    if [[ -z "$task_id" ]]; then
        echo "null"
        return 0
    fi
    echo "$response"
    return 0
}

start_task() {
    local task_id="$1"
    local url="${SERVER_URL}/worker/start-task"
    local data
    data=$(jq -n --arg token "$TOKEN" --arg tid "$task_id" '{token: $token, task_id: ($tid | tonumber)}')
    local response
    if ! response=$(http_post "$url" "$data"); then
        log "start_task: failed to start task $task_id"
        return 1
    fi
    local status
    status=$(echo "$response" | jq -r '.status // "unknown"')
    if [[ "$status" == "running" ]]; then
        log "start_task: task $task_id started successfully"
        return 0
    else
        log "start_task: server returned status '$status' for task $task_id"
        return 1
    fi
}

check_cancellation() {
    local task_id="$1"
    local url="${SERVER_URL}/worker/is-cancelled?token=${TOKEN}&task_id=${task_id}"
    local response
    if ! response=$(http_get "$url"); then
        log "check_cancellation: error, assuming not cancelled"
        return 1  # assume not cancelled on error
    fi
    local cancelled
    cancelled=$(echo "$response" | jq -r '.cancelled // false')
    if [[ "$cancelled" == "true" ]]; then
        log "Task $task_id was cancelled by server"
        return 0
    else
        return 1
    fi
}

send_report() {
    local task_id="$1"
    local content="$2"
    local url="${SERVER_URL}/worker/report"
    local data
    data=$(jq -n --arg token "$TOKEN" --arg tid "$task_id" --arg cnt "$content" '{token: $token, task_id: ($tid | tonumber), content: $cnt}')
    local response
    if ! response=$(http_post "$url" "$data"); then
        log "send_report: failed for task $task_id"
        return 1
    fi
    log "send_report: success for task $task_id"
    return 0
}

upload_file() {
    local task_id="$1"
    local file_path="$2"
    local url="${SERVER_URL}/worker/upload"
    local response
    if ! response=$(http_upload "$url" "$file_path" "$TOKEN" "$task_id"); then
        log "upload_file: failed for task $task_id"
        return 1
    fi
    log "upload_file: success for task $task_id"
    return 0
}

# ----------------------------- Task Execution ----------------------------

execute_task() {
    local task_id="$1"
    local command="$2"
    local output_file
    output_file=$(mktemp -p /tmp "worker_out_${task_id}_XXXXXX")
    trap 'rm -f "$output_file"' RETURN

    log "Executing task $task_id: $command"
    eval "$command" > "$output_file" 2>&1 &
    local cmd_pid=$!
    local cancelled=0

    while kill -0 "$cmd_pid" 2>/dev/null; do
        if check_cancellation "$task_id"; then
            cancelled=1
            log "Task $task_id cancelled, terminating process $cmd_pid"
            kill -TERM "$cmd_pid" 2>/dev/null || true
            sleep 2
            kill -KILL "$cmd_pid" 2>/dev/null || true
            wait "$cmd_pid" 2>/dev/null || true
            break
        fi
        sleep "$CANCEL_CHECK_INTERVAL"
    done

    if [[ $cancelled -eq 0 ]]; then
        wait "$cmd_pid"
        local exit_code=$?
        log "Task $task_id finished with exit code $exit_code"
    else
        wait "$cmd_pid" 2>/dev/null || true
        local exit_code=$?
        log "Task $task_id was cancelled, exit code $exit_code"
        return 1  # cancelled
    fi

    local output_content=""
    local report_msg=""
    if [[ -s "$output_file" ]]; then
        output_content=$(head -c 1000 "$output_file")
    fi
    report_msg="Exit code: ${exit_code}. Output: ${output_content}"

    local upload_success=0
    if [[ -s "$output_file" ]]; then
        if upload_file "$task_id" "$output_file"; then
            upload_success=1
        else
            queue_upload "$task_id" "$output_file"
        fi
    fi

    if [[ $upload_success -eq 1 ]]; then
        report_msg="Task completed. Output file uploaded. ${report_msg}"
    else
        report_msg="Task completed. Output file queued for upload. ${report_msg}"
    fi

    if ! send_report "$task_id" "$report_msg"; then
        queue_report "$task_id" "$report_msg"
    fi

    return 0
}

# ----------------------------- Exponential Backoff -----------------------

reset_backoff() {
    CURRENT_BACKOFF=$BACKOFF_MIN
}

increase_backoff() {
    local next=$((CURRENT_BACKOFF * 2))
    if [[ $next -gt $BACKOFF_MAX ]]; then
        CURRENT_BACKOFF=$BACKOFF_MAX
    else
        CURRENT_BACKOFF=$next
    fi
    log "Increased backoff to $CURRENT_BACKOFF"
}

wait_with_backoff() {
    log "Waiting $CURRENT_BACKOFF seconds before retry"
    sleep "$CURRENT_BACKOFF"
}

# ----------------------------- Main Loop --------------------------------

run_forever() {
    local health_counter=0
    log "Entering main loop"

    while true; do
        if process_queue; then
            reset_backoff
        else
            increase_backoff
        fi

        health_counter=$((health_counter + 1))
        if [[ $health_counter -ge $((HEALTH_INTERVAL / TASK_POLL_INTERVAL)) ]]; then
            health_check || true
            health_counter=0
        fi

        local task_response
        if ! task_response=$(get_current_task); then
            increase_backoff
            wait_with_backoff
            continue
        fi

        reset_backoff

        if [[ "$task_response" == "null" ]]; then
            # No task, just wait
            sleep "$TASK_POLL_INTERVAL"
            continue
        fi

        local task_id content status
        task_id=$(echo "$task_response" | jq -r '.task.id')
        content=$(echo "$task_response" | jq -r '.task.content')
        status=$(echo "$task_response" | jq -r '.task.status // "pending"')

        log "Received task $task_id with status $status"

        if [[ "$status" != "pending" && "$status" != "running" ]]; then
            sleep "$TASK_POLL_INTERVAL"
            continue
        fi

        if ! start_task "$task_id"; then
            sleep "$TASK_POLL_INTERVAL"
            continue
        fi

        execute_task "$task_id" "$content" || true
    done
}

# ----------------------------- Install / Uninstall -----------------------

do_install() {
    local url=""
    local token=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --install) shift ;;
            --url)
                url="$2"
                shift 2
                ;;
            --token)
                token="$2"
                shift 2
                ;;
            *)
                echo "Unknown option: $1" >&2
                exit 1
                ;;
        esac
    done

    if [[ -z "$url" || -z "$token" ]]; then
        echo "Usage: $0 --install --url <URL> --token <TOKEN>" >&2
        exit 1
    fi

    mkdir -p "$(dirname "$CONFIG_FILE")"
    cat > "$CONFIG_FILE" <<EOF
SERVER_URL="$url"
TOKEN="$token"
EOF
    chmod 600 "$CONFIG_FILE"
    echo "Configuration written to $CONFIG_FILE"

    local script_path
    script_path="$(realpath "$0")"
    chmod +x "$script_path"
    echo "Made script executable."

    # Add to .bashrc
    local bashrc_line="( flock -n /tmp/worker_client.lock -c \"$script_path\" </dev/null >/dev/null 2>&1 & )"
    if ! grep -Fxq "$bashrc_line" "$HOME/.bashrc" 2>/dev/null; then
        echo "$bashrc_line" >> "$HOME/.bashrc"
        echo "Added autostart to ~/.bashrc"
    else
        echo "Autostart entry already exists in ~/.bashrc"
    fi

    # Start the worker immediately in background using nohup (more reliable)
    # Use --foreground to prevent re‑forking when started from terminal
    nohup bash "$script_path" --foreground </dev/null >/dev/null 2>&1 &
    echo "Worker started in background (nohup). Check $LOG_FILE for logs."

    echo "Installation complete."
}

do_uninstall() {
    local script_path
    script_path="$(realpath "$0")"
    local bashrc_line="( flock -n /tmp/worker_client.lock -c \"$script_path\" </dev/null >/dev/null 2>&1 & )"
    if [[ -f "$HOME/.bashrc" ]]; then
        sed -i "\|$bashrc_line|d" "$HOME/.bashrc"
        echo "Removed autostart from ~/.bashrc"
    fi
    rm -f "$LOCK_FILE" "$PID_FILE" 2>/dev/null || true
    echo "Cleaned up lock and PID files."
    echo "Uninstall complete. The worker will not start again in new shells."
}

# ----------------------------- Main --------------------------------------
main() {
    # ============================================================
    # Command-line arguments
    # ============================================================

    if [[ $# -gt 0 ]]; then
        case "$1" in
            --install)
                do_install "$@"
                exit 0
                ;;
            --uninstall)
                do_uninstall
                exit 0
                ;;
            --foreground)
                FOREGROUND=1
                shift
                ;;
            *)
                echo "Usage:"
                echo "  $0 --install --url <URL> --token <TOKEN>"
                echo "  $0 --uninstall"
                echo "  $0 --foreground (for debugging)"
                exit 1
                ;;
        esac
    fi

    # ============================================================
    # Interactive execution detection
    # ============================================================
    # If this is a terminal and we are not in foreground mode,
    # spawn a background version and exit immediately.
    if [[ -z "${FOREGROUND:-}" && -t 0 ]]; then
        # Use nohup to detach completely
        nohup bash "$0" --foreground </dev/null >/dev/null 2>&1 &
        exit 0
    fi

    # ============================================================
    # Daemon mode (foreground or background)
    # ============================================================

    # Redirect stdout/stderr to log file (only after possible re‑exec)
    exec >> "$LOG_FILE" 2>&1

    log "=== Worker started (PID $$) ==="

    # Check dependencies
    check_deps

    # Load config
    load_config

    # Acquire lock (exits if already running)
    acquire_lock

    # Start the main loop
    run_forever
}

main "$@"
